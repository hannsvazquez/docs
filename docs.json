          },
          {
            "group": "Versión 3.0",
            "icon": "sparkles",
            "pages": [
              "press-release/version-3-0/inventario-de-proyectos"
            ]
          }
        ],
        "icon": "newspaper"
      }
    ]
  },
  "footer": {
