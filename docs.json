            "group": "Resumen",
            "pages": [
              "changelog/introduction",
              "changelog/versioning"
            ]
          },
          {
            "group": "Ciclos",
            "icon": "circle-arrow-out-up-right",
            "pages": [
              "changelog/cycles/cycle-05"
            ]
          }
        ],
        "icon": "workflow"
      },
      {
        "tab": "Press Release",
